{
    "name": "contextbridge",
    "displayName": "ContextBridge",
    "description": "Deterministic context synchronization between IDE and browser-based LLMs",
    "version": "0.1.1",
    "icon": "assets/icon.png",
    "engines": {
      "vscode": "^1.75.0"
    },
    "categories": [
      "Other"
    ],
    "main": "./out/extension.js",
    "contributes": {
      "commands": [
        {
          "command": "contextbridge.syncRepo",
          "title": "ContextBridge: Sync Repo → Chat"
        },
        {
          "command": "contextbridge.deepSyncFile",
          "title": "ContextBridge: Deep Sync Current File → Chat"
        }
      ]
    },
    "scripts": {
      "vscode:prepublish": "npm run compile",
      "compile": "tsc -p ./",
      "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
      "@types/vscode": "^1.74.0",
      "@types/node": "16.x",
      "typescript": "^4.9.4"
    },
    "publisher": "vivek-hipparkar"
  }